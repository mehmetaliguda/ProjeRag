# Backend Configuration
# Modify this single value to point the entire frontend to a different backend server

# API Base URL - The main backend server address
# Examples:
#   - Local development: http://127.0.0.1:5000
#   - Remote server: http://api.example.com:5000
#   - Docker: http://host.docker.internal:5000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5000

# (Optional) Backend Host - Extracted automatically from API_BASE_URL if not specified
# NEXT_PUBLIC_BACKEND_HOST=127.0.0.1

# (Optional) Backend Port - Extracted automatically from API_BASE_URL if not specified
# NEXT_PUBLIC_BACKEND_PORT=5000

# (Optional) Upload API URL - If different from default
# NEXT_PUBLIC_UPLOAD_API_URL=http://127.0.0.1:5000/upload

# (Optional) WebSocket URL - For future real-time features
# NEXT_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:5000/ws
