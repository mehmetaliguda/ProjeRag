# rag.env - RAG projesi ortam degiskenleri

# Ollama (LLM + embedding) - kendi bilgisayarinin adresi (Tailscale/SSH tunel/vs.)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Flask'in disariya donecegi citation/PDF linklerinin base URL'i (sunucunun kendi adresi)
APP_BASE_URL=http://127.0.0.1:5000

# Oda (multi-PDF) verilerinin diskte tutulacagi klasor
RAG_ROOMS_ROOT=/home/ali/pdf-chat-api/backend/rag_rooms

# Notebook/Conversation/Message/Room verilerinin tutuldugu veritabani
DATABASE_URL=sqlite:///app.db